<!DOCTYPE html> <html lang="en"> <head>     <meta charset="UTF-8">     <title>Typing Game</title>     <style>         body {             font-family: Arial, sans-serif;             text-align: center;             margin-top: 40px;             background: #f4f4f4;         }         h1 {             color: #333;         }         #gameArea {             display: none;         }         #word {             font-size: 32px;             margin: 20px 0;             font-weight: bold;         }         #inputField {             font-size: 18px;             padding: 8px;             width: 220px;         }         #feedback {             margin-top: 15px;             font-size: 20px;         }         #score, #time, .highScore {             font-weight: bold;             color: #222;         }         button {             margin-top: 20px;             padding: 10px 20px;             font-size: 16px;             border: none;             background: #007BFF;             color: white;             border-radius: 8px;             cursor: pointer;         }         button:hover {             background: #0056b3;         }         select {             font-size: 16px;             padding: 5px;         }     </style> </head> <body>     <h1>Typing Game</h1>      <!-- Difficulty selection -->     <div id="startMenu">         <p>Select Difficulty:</p>         <select id="difficulty">             <option value="easy">Easy (40s)</option>             <option value="medium">Medium (30s)</option>             <option value="hard">Hard (20s)</option>         </select>         <br>         <button id="startBtn">Start Game</button>     </div>      <!-- Game area -->     <div id="gameArea">         <p>Score: <span id="score">0</span></p>         <p>Time left: <span id="time">30</span> seconds</p>         <p>High Score (<span id="difficultyLabel">Medium</span>): <span id="highScore">0</span></p>          <div id="word">example</div>         <input type="text" id="inputField" placeholder="Type the word here" autofocus>         <div id="feedback"></div>         <button id="restartBtn">Restart</button>     </div>      <script>         // Word lists         const words = {             easy: ['cat','dog','sun','cup','ball','book','fish','pen','apple','tree','hat','car','milk','rain','star'],             medium: ['coding','javascript','typing','challenge','keyboard','player','function','variable','object','window','screen','random','element','style','script'],             hard: ['programming','development','application','difficulty','extraordinary','synchronization','implementation','configuration','internationalization','architecture','optimization','asynchronous','responsiveness']         };          let currentWord = '';         let score = 0;         let time = 30;         let timer;         let difficultyLevel = 'medium';          // Elements         const wordElement = document.getElementById('word');         const inputField = document.getElementById('inputField');         const feedbackElement = document.getElementById('feedback');         const scoreElement = document.getElementById('score');         const timeElement = document.getElementById('time');         const restartBtn = document.getElementById('restartBtn');         const startBtn = document.getElementById('startBtn');         const startMenu = document.getElementById('startMenu');         const gameArea = document.getElementById('gameArea');         const difficultySelect = document.getElementById('difficulty');         const highScoreElement = document.getElementById('highScore');         const difficultyLabel = document.getElementById('difficultyLabel');          function getRandomWord() {             const list = words[difficultyLevel];             const randomIndex = Math.floor(Math.random() * list.length);             return list[randomIndex];         }          function setNewWord() {             currentWord = getRandomWord();             wordElement.textContent = currentWord;             inputField.value = '';             feedbackElement.textContent = '';         }          function startTimer() {             clearInterval(timer);             timer = setInterval(() => {                 time--;                 timeElement.textContent = time;                  if (time === 0) {                     clearInterval(timer);                     inputField.disabled = true;                     feedbackElement.textContent = "⏳ Game Over! Final Score: " + score;                     feedbackElement.style.color = 'blue';                      // Save high score if needed                     saveHighScore();                 }             }, 1000);         }          inputField.addEventListener('keydown', function(event) {             if (event.key === 'Enter' && time > 0) {                 if (inputField.value.trim() === currentWord) {                     feedbackElement.textContent = '✅ Correct!';                     feedbackElement.style.color = 'green';                     score++;                     scoreElement.textContent = score;                 } else {                     feedbackElement.textContent = '❌ Try again!';                     feedbackElement.style.color = 'red';                 }                 setTimeout(setNewWord, 400);             }         });          restartBtn.addEventListener('click', () => {             startGame(difficultyLevel);         });          startBtn.addEventListener('click', () => {             difficultyLevel = difficultySelect.value;             difficultyLabel.textContent = capitalize(difficultyLevel);             startMenu.style.display = 'none';             gameArea.style.display = 'block';             startGame(difficultyLevel);         });          function startGame(level) {             score = 0;             scoreElement.textContent = score;              // set time by difficulty             if (level === 'easy') time = 40;             else if (level === 'medium') time = 30;             else if (level === 'hard') time = 20;              timeElement.textContent = time;             inputField.disabled = false;             inputField.focus();             setNewWord();             loadHighScore(level);             startTimer();         }          // High score functions         function saveHighScore() {             let savedHighScore = localStorage.getItem('highScore_' + difficultyLevel) || 0;             if (score > savedHighScore) {                 localStorage.setItem('highScore_' + difficultyLevel, score);                 highScoreElement.textContent = score;             }         }          function loadHighScore(level) {             let savedHighScore = localStorage.getItem('highScore_' + level) || 0;             highScoreElement.textContent = savedHighScore;         }          function capitalize(str) {             return str.charAt(0).toUpperCase() + str.slice(1);         }     </script> </body> </html> 

